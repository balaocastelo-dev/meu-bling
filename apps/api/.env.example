# ===== MEU BLING — API =====
# Banco de dados (SQLite local). Para PostgreSQL: postgresql://user:senha@localhost:5432/meubling
DATABASE_URL="file:../data/meubling.db"

# Porta da API
PORT=3333
HOST=0.0.0.0

# Segredos (gerados automaticamente pelo instalador — troque em produção)
JWT_SECRET="troque-este-segredo-jwt"
# Chave de 32+ caracteres usada para criptografar senhas de certificado, SMTP, tokens (AES-256-GCM)
APP_SECRET="troque-esta-chave-de-criptografia-32-chars"

# URL pública do frontend (usada em links de e-mail/WhatsApp e no "chamar atenção")
APP_URL="http://localhost:5173"
# Subpasta quando o sistema publica em /sistema (o link do WhatsApp fica APP_URL + BASE_PATH + /chat/id)
# BASE_PATH="/sistema"

# O "chamar atenção" manda WhatsApp pela sessão já configurada na tela
# Configurações → WhatsApp (Evolution API ou QR Code Baileys). Não há URL/token
# separado aqui — não coloque chave nenhuma neste arquivo.

# Pasta de armazenamento (XMLs, DANFEs, anexos, sessão WhatsApp)
STORAGE_DIR="./storage"

# Ambiente: development | production
NODE_ENV=development
